# GLOBAL SECURITY
# Global-wide ignores necessary to keep the security of the project
.env.local
*.pem
*.key

# CHROMADB & DATA
# Heavy data unneeded to be committed + secured in local repo only
rag/chroma/
rag/data/
*.sqlite3
*.bin

# FASTAPI & PYTHON
# Caches, virtual environments, coverage, etc
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# NEXT.JS, VITE, REACT, & TYPESCRIPT
# Node modules, build artifacts, caches, package setup files, etc
node_modules/
dist/
build/
.next/
.npm/
npm-debug.log*
.turbo/

# OPERATING SYSTEM GENERATED FILES
.DS_Store
Thumbs.db
