# GLOBAL SECURITY
# Prevent repository metadata from being copied into the image
.git/
.gitignore

# CHROMADB & DATA
# Ignore local AI data (Docker should use volumes for this, not bake it into the image)
rag/chroma/
rag/data/

# FASTAPI & PYTHON
# Prevent local Python environments and build caches from overwriting container setups
__pycache__/
*.py[cod]
.venv/
venv/

# VITE, REACT, & TYPESCRIPT
# Prevent local Node environments and frontend build artifacts from being copied
node_modules/
dist/
build/

# OPERATING SYSTEM GENERATED FILES
# Ignore OS-specific meta files
.DS_Store